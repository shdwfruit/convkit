wav -> m4a: ffmpeg -i in.wav -map 0:a -map 0:v? -c:v copy -c:a aac -b:a 192k -y out.m4a
wav -> mp3: ffmpeg -i in.wav -map 0:a -map 0:v? -c:v copy -c:a libmp3lame -q:a 2 -y out.mp3
