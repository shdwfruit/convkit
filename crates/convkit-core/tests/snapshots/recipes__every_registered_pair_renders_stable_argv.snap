mp3 -> flac: ffmpeg -i in.mp3 -map 0:a -map 0:v? -c:v copy -c:a flac -y out.flac
mp3 -> m4a: ffmpeg -i in.mp3 -map 0:a -map 0:v? -c:v copy -c:a aac -b:a 192k -y out.m4a
mp3 -> wav: ffmpeg -i in.mp3 -vn -c:a pcm_s16le -y out.wav
