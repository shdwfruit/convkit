ods -> pdf: soffice -env:UserInstallation=<per-run temp profile> --headless --norestore --convert-to pdf --outdir . in.ods
odt -> pdf: soffice -env:UserInstallation=<per-run temp profile> --headless --norestore --convert-to pdf --outdir . in.odt
pdf -> docx: soffice -env:UserInstallation=<per-run temp profile> --headless --norestore --infilter=writer_pdf_import --convert-to docx:MS Word 2007 XML --outdir . in.pdf
png -> avif: magick in.png -auto-orient -quality 92 out.avif
png -> bmp: magick in.png[0] -auto-orient out.bmp
png -> jpg: magick in.png[0] -auto-orient -background white -alpha remove -alpha off -quality 92 out.jpg
png -> pdf: magick in.png -auto-orient -compress jpeg -quality 92 out.pdf
png -> tiff: magick in.png -auto-orient out.tiff
png -> webp: magick in.png -auto-orient -quality 92 out.webp
pptx -> pdf: soffice -env:UserInstallation=<per-run temp profile> --headless --norestore --convert-to pdf --outdir . in.pptx
svg -> jpg: magick -density 384 -background white in.svg -alpha remove -alpha off -flatten -quality 92 out.jpg
svg -> png: magick -density 384 -background none in.svg out.png
tiff -> avif: magick in.tiff -auto-orient -quality 92 out.avif
tiff -> bmp: magick in.tiff[0] -auto-orient out.bmp
tiff -> jpg: magick in.tiff[0] -auto-orient -background white -alpha remove -alpha off -quality 92 out.jpg
tiff -> pdf: magick in.tiff -auto-orient -compress jpeg -quality 92 out.pdf
tiff -> png: magick in.tiff[0] -auto-orient out.png
tiff -> webp: magick in.tiff -auto-orient -quality 92 out.webp
