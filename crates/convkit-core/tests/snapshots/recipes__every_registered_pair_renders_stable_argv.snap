mp4 -> gif: ffmpeg -i in.mp4 -vf fps=15,scale=w=min(640\,iw):h=-2:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=3 -loop 0 -y out.gif
mp4 -> m4a: ffmpeg -i in.mp4 -vn -c:a aac -b:a 192k -y out.m4a
mp4 -> mkv: ffmpeg -i in.mp4 -map 0 -map -0:d -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -c:s srt -y out.mkv
