mov -> gif: ffmpeg -i in.mov -vf fps=15,scale=w=min(640\,iw):h=-2:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=3 -loop 0 -y out.gif
mov -> m4a: ffmpeg -i in.mov -vn -c:a aac -b:a 192k -y out.m4a
mov -> mkv: ffmpeg -i in.mov -map 0 -map -0:d -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -c:s srt -y out.mkv
mov -> mp3: ffmpeg -i in.mov -vn -c:a libmp3lame -q:a 2 -y out.mp3
mov -> mp4: ffmpeg -i in.mov -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -sn -movflags +faststart -y out.mp4
