---
source: crates/convkit-core/tests/recipes.rs
expression: "lines.join(\"\\n\")"
---
avi -> flac: ffmpeg -i in.avi -vn -c:a flac -y out.flac
avi -> gif: ffmpeg -i in.avi -vf fps=15,scale=w=min(640\,iw):h=-2:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=3 -loop 0 -y out.gif
avi -> m4a: ffmpeg -i in.avi -vn -c:a aac -b:a 192k -y out.m4a
avi -> mkv: ffmpeg -i in.avi -map 0 -map -0:d -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -c:s copy -y out.mkv
avi -> mov: ffmpeg -i in.avi -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -sn -movflags +faststart -y out.mov
avi -> mp3: ffmpeg -i in.avi -vn -c:a libmp3lame -q:a 2 -y out.mp3
avi -> mp4: ffmpeg -i in.avi -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -preset medium -pix_fmt yuv420p -c:a aac -b:a 160k -sn -movflags +faststart -y out.mp4
avi -> wav: ffmpeg -i in.avi -vn -c:a pcm_s16le -y out.wav
avi -> webm: ffmpeg -i in.avi -c:v libvpx-vp9 -crf 32 -b:v 0 -row-mt 1 -threads 0 -c:a libopus -b:a 128k -af aformat=channel_layouts=7.1|5.1|stereo|mono -y out.webm
avif -> bmp: magick in.avif[0] -auto-orient out.bmp
avif -> jpg: magick in.avif[0] -auto-orient -background white -alpha remove -alpha off -quality 92 out.jpg
avif -> pdf: magick in.avif -auto-orient -compress jpeg -quality 92 out.pdf
avif -> png: magick in.avif[0] -auto-orient out.png
avif -> tiff: magick in.avif -auto-orient out.tiff
avif -> webp: magick in.avif -auto-orient -quality 92 out.webp
bmp -> avif: magick in.bmp -auto-orient -quality 92 out.avif
bmp -> jpg: magick in.bmp[0] -auto-orient -background white -alpha remove -alpha off -quality 92 out.jpg
bmp -> pdf: magick in.bmp -auto-orient -compress jpeg -quality 92 out.pdf
bmp -> png: magick in.bmp[0] -auto-orient out.png
bmp -> tiff: magick in.bmp -auto-orient out.tiff
bmp -> webp: magick in.bmp -auto-orient -quality 92 out.webp
docx -> pdf: soffice -env:UserInstallation=<per-run temp profile> --headless --norestore --convert-to pdf --outdir . in.docx
flac -> m4a: ffmpeg -i in.flac -map 0:a -map 0:v? -c:v copy -c:a aac -b:a 192k -y out.m4a
flac -> mp3: ffmpeg -i in.flac -map 0:a -map 0:v? -c:v copy -c:a libmp3lame -q:a 2 -y out.mp3
flac -> wav: ffmpeg -i in.flac -vn -c:a pcm_s16le -y out.wav
gif -> mp4: ffmpeg -i in.gif -vf scale=trunc(iw/2)*2:trunc(ih/2)*2 -c:v libx264 -crf 20 -pix_fmt yuv420p -movflags +faststart -y out.mp4
heic -> avif: magick in.heic -auto-orient -quality 92 out.avif
heic -> bmp: magick in.heic[0] -auto-orient out.bmp
heic -> jpg: magick in.heic[0] -auto-orient -background white -alpha remove -alpha off -quality 92 out.jpg
heic -> pdf: magick in.heic -auto-orient -compress jpeg -quality 92 out.pdf
heic -> png: magick in.heic[0] -auto-orient out.png
heic -> tiff: magick in.heic -auto-orient out.tiff
heic -> webp: magick in.heic -auto-orient -quality 92 out.webp
heif -> avif: magick in.heif -auto-orient -quality 92 out.avif
heif -> bmp: magick in.heif[0] -auto-orient out.bmp
heif -> jpg: magick in.heif[0] -auto-orient -background white -alpha remove -alpha off -quality 92 out.jpg
heif -> pdf: magick in.heif -auto-orient -compress jpeg -quality 92 out.pdf
heif -> png: magick in.heif[0] -auto-orient out.png
heif -> tiff: magick in.heif -auto-orient out.tiff
heif -> webp: magick in.heif -auto-orient -quality 92 out.webp
jpg -> avif: magick in.jpg -auto-orient -quality 92 out.avif
jpg -> bmp: magick in.jpg[0] -auto-orient out.bmp
jpg -> pdf: magick in.jpg -auto-orient -compress jpeg -quality 92 out.pdf
jpg -> png: magick in.jpg[0] -auto-orient out.png
jpg -> tiff: magick in.jpg -auto-orient out.tiff
jpg -> webp: magick in.jpg -auto-orient -quality 92 out.webp
m4a -> flac: ffmpeg -i in.m4a -map 0:a -map 0:v? -c:v copy -c:a flac -y out.flac
m4a -> mp3: ffmpeg -i in.m4a -map 0:a -map 0:v? -c:v copy -c:a libmp3lame -q:a 2 -y out.mp3
m4a -> wav: ffmpeg -i in.m4a -vn -c:a pcm_s16le -y out.wav
md -> docx: pandoc in.md --standalone --resource-path . -o out.docx
md -> html: pandoc in.md --standalone --resource-path . -o out.html
md -> pdf: pandoc in.md --standalone --resource-path . -o out.convkit-step0.docx
md -> pdf: soffice -env:UserInstallation=<per-run temp profile> --headless --norestore --convert-to pdf --outdir . out.convkit-step0.docx
mkv -> flac: ffmpeg -i in.mkv -vn -c:a flac -y out.flac
mkv -> gif: ffmpeg -i in.mkv -vf fps=15,scale=w=min(640\,iw):h=-2:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=3 -loop 0 -y out.gif
mkv -> m4a: ffmpeg -i in.mkv -vn -c:a aac -b:a 192k -y out.m4a
